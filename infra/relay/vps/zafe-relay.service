# /etc/systemd/system/zafe-relay.service
# The relay listens on localhost only; Caddy terminates TLS in front of it.
[Unit]
Description=Zafe blind relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zafe-relay
Environment=ZAFE_RELAY_LISTEN=127.0.0.1:8787
Environment=ZAFE_RELAY_DB=/var/lib/zafe-relay/relay.sqlite
Environment=RUST_LOG=zafe_relay=info
# Behind Caddy: the client address is the entry Caddy adds to X-Forwarded-For.
Environment=ZAFE_RELAY_CLIENT_IP_HEADER=x-forwarded-for
# FCM (optional): put the service-account key at /etc/zafe-relay/fcm-service-account.json
# (root:root 0600) and uncomment both lines. systemd hands the service a private copy.
#LoadCredential=fcm.json:/etc/zafe-relay/fcm-service-account.json
#Environment=ZAFE_FCM_SERVICE_ACCOUNT=%d/fcm.json

DynamicUser=yes
StateDirectory=zafe-relay
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=30s

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
