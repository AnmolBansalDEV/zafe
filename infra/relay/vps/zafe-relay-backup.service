# /etc/systemd/system/zafe-relay-backup.service (run nightly by zafe-relay-backup.timer)
# Online, consistent copy with SQLite's backup API (safe while the relay runs, WAL
# included), compressed, 14 days kept. Copy /var/backups/zafe-relay off the machine too
# (rclone/restic), or use Litestream instead (see README).
[Unit]
Description=Back up the Zafe relay database
After=zafe-relay.service

[Service]
Type=oneshot
UMask=0077
ExecStart=/bin/sh -eu -c '\
  mkdir -p /var/backups/zafe-relay; \
  out=/var/backups/zafe-relay/relay-$$(date -u +%%Y%%m%%dT%%H%%M%%SZ).sqlite; \
  sqlite3 /var/lib/private/zafe-relay/relay.sqlite ".backup $$out"; \
  sqlite3 "$$out" "PRAGMA integrity_check" | grep -qx ok; \
  gzip "$$out"; \
  find /var/backups/zafe-relay -name "relay-*.sqlite.gz" -mtime +14 -delete'
