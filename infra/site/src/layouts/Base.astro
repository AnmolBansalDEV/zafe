---
// Every page: CSP meta, fonts, the one stylesheet. Pages add their own scripts through
// the "head" slot, only as same-origin files (`is:inline src=...`).
import '../styles/site.css';
import { csp } from '../config';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  noindex?: boolean;
}

const { title, description, bodyClass, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="no-referrer" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#F1F5F5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080B0B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/assets/zafe.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/SpaceGrotesk-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/DMSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
