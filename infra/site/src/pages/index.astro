---
// Landing page, laid out after vizor.cash (centred hero, device showcase, illustrated
// pillars, a dark feature panel with live UI cards, FAQ, closing card, dark footer) with
// Zafe's brand, art and copy. Copy: short, and "Zcash" only where it's needed. Every
// claim must be something the app does today (docs/tracker.md); the chain card is the
// real testnet payment from the 2026-09-30 dry run. No JavaScript: the intro is CSS and
// the FAQ is <details>.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import { downloadUrl, sourceUrl } from '../config';

const specUrl = `${sourceUrl}/blob/main/spec.md`;

const pillars = [
  { art: 'art_gate', width: 700, height: 560, title: 'Shared', text: 'Pick how many must approve. Nobody moves money alone.' },
  { art: 'art_seal', width: 700, height: 560, title: 'Private', text: 'The chain can’t even tell it’s a multisig.' },
  { art: 'art_ledger', width: 740, height: 592, title: 'Verifiable', text: 'Open source. Every phone checks before it signs.' },
];

const faq = [
  { q: 'Is Zafe safe to use?', a: 'It’s on testnet and not yet audited. Everything is open source. Don’t use real funds yet.' },
  { q: 'Is it really a multisig?', a: 'Yes, just not on-chain. Each phone holds a key share (FROST), and enough shares make one ordinary signature.' },
  { q: 'What can the relay see?', a: 'Who messages whom, and when. Never amounts, addresses or keys. It can’t sign or move funds.' },
  { q: 'What if someone loses their phone?', a: 'The vault keeps working while enough members have theirs, and the share comes back from its encrypted backup. Lose too many, and the funds are gone for good.' },
  { q: 'Can we remove a member?', a: 'Not yet. Make a new vault and move the funds.' },
  { q: 'Which platforms?', a: 'Android. iPhone later.' },
];
---

<Base
  title="Zafe: the multisig nobody can see"
  description="A shielded Zcash multisig. One private vault for your team: nothing moves until enough of you approve."
  bodyClass="home"
>
  <!-- Intro (CSS only): the screen is the mark's tile, its two pieces lock, then it
       collapses up into the nav logo while the page appears. Skipped with
       prefers-reduced-motion. -->
  <div class="intro" aria-hidden="true">
    <div class="intro-veil"></div>
    <div class="intro-ring"></div>
    <div class="intro-ring second"></div>
    <div class="intro-mark"><Mark /></div>
  </div>

  <header class="nav">
    <nav class="nav-side left" aria-label="Page">
      <a href="#features">Features</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="nav-logo" href="/" aria-label="Zafe home"><Mark /></a>
    <nav class="nav-side right" aria-label="Links">
      <a href={sourceUrl} rel="noopener noreferrer">Source</a>
      <a href={downloadUrl} rel="noopener noreferrer">Get Zafe</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="tag">Now on testnet</p>
      <h1>The multisig<br />nobody can see</h1>
      <p class="sub">One private vault for your team. Nothing moves until enough of you approve.</p>
      <a class="pill" href={downloadUrl} rel="noopener noreferrer">Get Zafe</a>
    </section>

    <div class="stage">
      <p class="notch">Android <span>&middot;</span> Open source <span>&middot;</span> Shielded</p>
      <div class="phones">
        <figure class="phone side">
          <img src="/assets/screens/phone_home_light.webp" width="390" height="844" alt="A member's home screen: the vault balance, 2 of 3 signers to send, a payment that needs their approval." />
        </figure>
        <figure class="phone front">
          <img src="/assets/screens/phone_review_light.webp" width="390" height="844" alt="Reviewing a 12.50 TAZ payment: 1 approval of the 2 needed, and the signers." />
        </figure>
        <figure class="phone side">
          <img src="/assets/screens/phone_sent_light.webp" width="390" height="844" alt="The same payment, sent." />
        </figure>
      </div>
    </div>

    <section class="pillars">
      {pillars.map((p) => (
        <article>
          <img src={`/assets/screens/${p.art}_light.webp`} width={p.width} height={p.height} alt="" loading="lazy" />
          <h2>{p.title}</h2>
          <p>{p.text}</p>
        </article>
      ))}
    </section>

    <section class="vision">
      <p class="tag plain">The idea</p>
      <p class="statement">Money your team holds together, and nobody else can see.</p>
    </section>

    <section id="features" class="panel">
      <header class="panel-head">
        <p class="tag dark">Features</p>
        <h2>Your treasury,<br />held together</h2>
        <p>The hard parts of a multisig, handled.</p>
      </header>

      <div class="feature">
        <div class="copy">
          <h3>Propose and approve</h3>
          <p>Anyone can propose. Everyone checks on their own phone and approves with a tap. The last approval sends it.</p>
          <ul class="ticks">
            <li><Icon name="plus" />Batch payments</li>
            <li><Icon name="edit" />Memos</li>
            <li><Icon name="import_wallet" />CSV import</li>
            <li><Icon name="users" />Up to 15 members</li>
          </ul>
        </div>
        <div class="widget">
          <div class="card pay">
            <p class="card-label">Payment</p>
            <p class="card-amount">12.50 <span>TAZ</span></p>
            <p class="card-to"><span>To shielded address</span><code>utest1k .... f6d8s0a</code></p>
          </div>
          <div class="card votes">
            <p><span class="dots"><i class="on"></i><i></i><b></b><i></i></span><span>1 approved &middot; needs 2 of 3</span></p>
            <p class="approve"><Icon name="check" />Approve and sign</p>
          </div>
        </div>
      </div>

      <div class="feature flip">
        <div class="copy">
          <h3>Checked on every phone</h3>
          <p>Your phone checks each payment against the vault&rsquo;s own keys. If anything&rsquo;s off, it won&rsquo;t sign.</p>
          <ul class="ticks">
            <li><Icon name="check" />Recipients</li>
            <li><Icon name="edit" />Amounts and memos</li>
            <li><Icon name="wallet" />Change</li>
            <li><Icon name="time" />Fee</li>
          </ul>
        </div>
        <div class="widget">
          <div class="card light checks">
            <p><span>Recipient</span><b>Matches</b></p>
            <p><span>Amount and memo</span><b>Match</b></p>
            <p><span>Change to vault</span><b>2.37485 TAZ</b></p>
            <p><span>Fee</span><b>0.00015 TAZ</b></p>
            <p class="verdict"><span>Checked on this device</span><b>Matches <Icon name="check_circle" /></b></p>
          </div>
        </div>
      </div>

      <div class="feature">
        <div class="copy">
          <h3>Invisible on-chain</h3>
          <p>The phones sign together as one. To the chain it&rsquo;s an ordinary shielded payment, like this real one from our testnet trial.</p>
        </div>
        <div class="widget">
          <dl class="card mono chain">
            <div><dt>tx</dt><dd>e6ccd6b707e8ee7e&hellip;1691e9eef0237</dd></div>
            <div><dt>block</dt><dd>4,422,289</dd></div>
            <div><dt>size</dt><dd>9,166 bytes</dd></div>
            <div><dt>fee</dt><dd>0.0001 TAZ</dd></div>
            <div><dt>amount</dt><dd class="hidden">encrypted</dd></div>
            <div><dt>to</dt><dd class="hidden">encrypted</dd></div>
          </dl>
        </div>
      </div>

      <div class="feature flip">
        <div class="copy">
          <h3>Private all the way</h3>
          <p>Tor for every connection. Encrypted backups. Viewing keys for auditors.</p>
          <ul class="ticks">
            <li><Icon name="tor" />Tor</li>
            <li><Icon name="lock" />Backups</li>
            <li><Icon name="eye" />Viewing keys</li>
            <li><Icon name="unlock" />Unlock to sign</li>
          </ul>
        </div>
        <div class="widget">
          <div class="card light settings">
            <p><Icon name="tor" /><span>Use Tor</span><i class="switch"></i></p>
            <p><Icon name="lock" /><span>Backup</span><b>Saved</b></p>
            <p><Icon name="eye" /><span>Viewing key</span><b>Share</b></p>
            <p><Icon name="unlock" /><span>Require unlock</span><i class="switch"></i></p>
          </div>
        </div>
      </div>
    </section>

    <section id="faq" class="faq">
      <h2>Questions?</h2>
      <div class="qa">
        {faq.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
        <p class="more">More in the <a href={specUrl} rel="noopener noreferrer">spec</a>.</p>
      </div>
    </section>

    <section class="closing">
      <div class="closing-copy">
        <p class="tag plain dark">Ready when you are</p>
        <h2>Start a shared vault</h2>
        <p>Two phones and a few testnet coins.</p>
        <a class="pill" href={downloadUrl} rel="noopener noreferrer">Get Zafe</a>
      </div>
      <img class="closing-art" src="/assets/screens/art_vault_dark.webp" width="1080" height="1120" alt="" loading="lazy" />
    </section>
  </main>

  <footer class="foot">
    <div class="foot-top">
      <p class="foot-brand"><img src="/assets/zafe.svg" alt="" width="52" height="52" /><span>Privacy,<br />held together.</span></p>
      <ul>
        <li><a href={downloadUrl} rel="noopener noreferrer">Android</a></li>
        <li><a href={sourceUrl} rel="noopener noreferrer">Source</a></li>
        <li><a href={specUrl} rel="noopener noreferrer">Spec</a></li>
        <li><a href={`${sourceUrl}/issues`} rel="noopener noreferrer">Support</a></li>
      </ul>
    </div>
    <div class="foot-bottom">
      <p>No cookies. No analytics.</p>
      <p>Zafe, 2026</p>
    </div>
    <p class="ghost" aria-hidden="true">zafe</p>
  </footer>
</Base>
