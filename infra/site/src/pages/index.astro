---
import Base from '../layouts/Base.astro';
import Actions from '../components/Actions.astro';
import Phone from '../components/Phone.astro';
import { downloadUrl } from '../config';

// Every claim here is something the app does today (docs/tracker.md); keep it that way.
const steps = [
  {
    title: 'Create a vault',
    text:
      'Choose how many approvals a payment needs: 2 of 3, 3 of 5, up to 15 members. ' +
      'Invite them with a link or a QR code. Every phone takes part in a key ceremony, ' +
      'and no device ever holds the whole key. Members compare a safety number to be ' +
      'sure nobody sits in the middle.',
  },
  {
    title: 'Propose a payment',
    text:
      'Any member can propose one: a single recipient, or up to 50 imported from a ' +
      'CSV, with a memo. Everyone gets a notification.',
  },
  {
    title: 'Approve on your phone',
    text:
      'Before you sign, your phone rebuilds the transaction and checks that it pays ' +
      'exactly who the proposal says. Approving signs in one tap, and the last approval ' +
      'sends the payment.',
  },
];

const features = [
  {
    title: 'Private by default',
    text:
      'Only members see the balance, amounts and memos. The relay that passes messages ' +
      'between phones only ever sees encrypted envelopes, never a viewing key.',
  },
  {
    title: 'No blind signing',
    text:
      'Each phone checks the transaction on its own before it adds a signature, so ' +
      'nobody can get you to sign anything other than the payment you see.',
  },
  {
    title: 'Non-custodial',
    text: "Neither Zafe nor the relay can move funds. Only the required number of members' keys can.",
  },
  {
    title: 'Tor built in',
    text:
      'Turn on Tor and every connection to the relay and the Zcash server goes through ' +
      "it, or doesn't happen at all.",
  },
  {
    title: 'Encrypted backups',
    text: 'Save your share of a vault as a passphrase-protected file and restore it on a new phone.',
  },
  {
    title: 'Ready for auditors',
    text: "Give an auditor a viewing key, or export the vault's history as a CSV made on your phone.",
  },
];

const caveats = [
  {
    title: 'Testnet only.',
    text: "Zafe hasn't had an external security audit yet. Mainnet waits for it.",
  },
  {
    title: 'Members see everything.',
    text:
      "Every member can see the vault's full history, including after they leave. " +
      'Removing someone completely means moving the funds to a new vault.',
  },
  {
    title: 'Keep backups.',
    text:
      'If more members lose their phones and backups than the vault can spare, the ' +
      'funds are gone for good. Nobody, Zafe included, can recover them.',
  },
  {
    title: 'Rules live in the app.',
    text:
      "Spending limits are checked by members' apps, not by the chain, so enough " +
      'members acting together can bypass them.',
  },
];
---

<Base
  title="Zafe: shielded multisig for Zcash"
  description="A shared Zcash wallet for DAOs, grant committees and small teams. Payments go out only when enough members approve them, and the chain can't tell it's a multisig."
  bodyClass="landing"
>
  <header class="topbar">
    <a class="brand" href="/">
      <img src="/assets/zafe.svg" alt="" width="32" height="32" />
      <span>Zafe</span>
    </a>
    <nav>
      <a href="#how">How it works</a>
      <a href="#security">Security</a>
      <a class="button small" href={downloadUrl} rel="noopener noreferrer">Download</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Shielded multisig for Zcash</p>
        <h1>Move your team's ZEC together, in private.</h1>
        <p class="lead">
          Zafe is a shared Zcash wallet for DAOs, grant committees and small teams. A
          payment goes out only when enough members approve it on their own phones, and
          the chain can't tell it's a multisig.
        </p>
        <Actions />
        <p class="small">On Zcash testnet for now. iPhone app later.</p>
      </div>
      <Phone
        screen="home"
        alt="Zafe's home screen: a vault balance of 42.37 TAZ, 2 of 3 signers to send, and a payment that needs your approval."
      />
    </section>

    <section class="band">
      <div class="split">
        <div>
          <h2>Nothing on-chain gives it away</h2>
          <p>
            On Ethereum, a Safe's owners, its threshold and every transaction are public.
            Zcash's shielded pool has no contracts, so Zafe uses FROST threshold
            signatures: the members' phones together produce one ordinary spend signature.
            To the chain, a Zafe vault looks like any other shielded wallet.
          </p>
        </div>
        <table class="compare">
          <thead>
            <tr><th></th><th>Safe on Ethereum</th><th>Zafe on Zcash</th></tr>
          </thead>
          <tbody>
            <tr><th>Visible on-chain</th><td>Owners, threshold, every payment</td><td class="yes">Nothing</td></tr>
            <tr><th>Threshold enforced by</th><td>A contract</td><td class="yes">Cryptography on members' phones</td></tr>
            <tr><th>Who sees the balance</th><td>Everyone</td><td class="yes">Members only</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="how">
      <h2>How it works</h2>
      <div class="split">
        <ol class="steps">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
        <Phone
          screen="proposal_review"
          lazy
          alt='Reviewing a 12.50 TAZ payment: 1 approval of the 2 needed, the signers, and "Checked on this device: Matches".'
        />
      </div>
    </section>

    <section id="security" class="band">
      <h2>Built so nobody has to be trusted alone</h2>
      <ul class="features">
        {features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Before you use it</h2>
      <ul class="caveats">
        {caveats.map((caveat) => (
          <li><b>{caveat.title}</b> {caveat.text}</li>
        ))}
      </ul>
    </section>

    <section class="cta">
      <h2>Try it on testnet</h2>
      <p class="lead">
        Install Zafe on two or three phones, create a vault and send some testnet coins
        (TAZ) around.
      </p>
      <Actions />
    </section>
  </main>

  <footer class="site-footer">
    Open source, MIT or Apache-2.0. Built on upstream Zcash and FROST libraries, with no
    custom cryptography.
  </footer>
</Base>
