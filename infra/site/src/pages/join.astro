---
// The invite page: https://<host>/join#<invite>. The invite is in the fragment and is
// handled only by public/assets/join.js, loaded as-is (never bundled or inlined): keep
// it hand-written and dependency-free. See README.md.
import Base from '../layouts/Base.astro';
import { downloadUrl } from '../config';
---

<Base title="Join a Zafe vault" noindex>
  <script is:inline slot="head" src="/assets/join.js" defer></script>
  <main>
    <header class="brand">
      <img src="/assets/zafe.svg" alt="" width="40" height="40" />
      <span>Zafe</span>
    </header>

    <h1>You're invited to a Zafe vault</h1>
    <p class="lead">
      Zafe is a shared Zcash wallet: a payment goes out only when enough members approve
      it. Someone sent you this link to give you a seat.
    </p>

    <section id="invite" hidden>
      <ol class="steps">
        <li>
          <h2>Install Zafe</h2>
          <p>Android 7 or newer. The iPhone app isn't available yet.</p>
          <a class="button" href={downloadUrl} target="_blank" rel="noopener noreferrer">Download for Android</a>
        </li>
        <li>
          <h2>Open the invite</h2>
          <p>Zafe opens on its Join screen with the invite filled in. You still confirm before joining.</p>
          <a class="button" id="open" href="#">Open in Zafe</a>
          <p class="small">
            Nothing happens? Copy the invite, then open Zafe, tap <b>Join with an invite</b>
            and paste it.
          </p>
          <button class="button secondary" id="copy" type="button">Copy invite</button>
          <p class="small" id="copied" role="status" aria-live="polite"></p>
        </li>
      </ol>
      <p class="note">
        Join only if you expected this invite. Until the vault's creator locks membership,
        anyone with it can take a seat, so don't forward it.
      </p>
    </section>

    <section id="missing" hidden>
      <p class="note">
        This link doesn't include an invite. Open it again from the message you got it in,
        or ask the person who invited you to send it again or to show you the QR code on
        their phone.
      </p>
    </section>

    <noscript>
      <p class="note">
        This page needs JavaScript to read the invite. Without it: install Zafe, tap
        <b>Join with an invite</b> and paste the whole link you were sent.
      </p>
    </noscript>

    <footer>
      This page runs only in your browser. The invite is the part of the link after
      <code>#</code>, which browsers never send to the server.
    </footer>
  </main>
</Base>
