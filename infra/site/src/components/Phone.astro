---
// An app screen in a phone frame, following the visitor's light/dark theme. Screens are
// the app's own renders, made by assets.py (public/assets/screens/<name>_{light,dark}.webp).
interface Props {
  screen: string;
  alt: string;
  lazy?: boolean;
}

const { screen, alt, lazy = false } = Astro.props;
---

<figure class="phone">
  <picture>
    <source srcset={`/assets/screens/${screen}_dark.webp`} media="(prefers-color-scheme: dark)" />
    <img
      src={`/assets/screens/${screen}_light.webp`}
      width="390"
      height="844"
      alt={alt}
      loading={lazy ? 'lazy' : undefined}
    />
  </picture>
</figure>
