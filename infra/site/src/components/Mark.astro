---
// The Seam mark (public/assets/zafe.svg) inlined, with classes on its tile and its two
// pieces so the intro can animate them. Presentation attributes only (CSP).
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  class?: string;
}

const { class: className = 'mark' } = Astro.props;
let n = 0;
const svg = readFileSync(resolve(process.cwd(), 'public/assets/zafe.svg'), 'utf8')
  .replace('<svg ', `<svg class="${className}" aria-hidden="true" focusable="false" `)
  .replace('<rect ', '<rect class="mark-tile" ')
  .replace(/<path /g, () => `<path class="mark-${n++ === 0 ? 'upper' : 'lower'}" `);
---

<Fragment set:html={svg} />
